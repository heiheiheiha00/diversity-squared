# Track only the D-QECG workspace from this root.
/*
!/.gitignore
!/D-QECG/
!/D-QECG/src/transformers/src/transformers/models/
/D-QECG/src/transformers/src/transformers/models/*
!/D-QECG/src/transformers/src/transformers/models/llama/
/D-QECG/src/transformers/src/transformers/models/llama/*
!/D-QECG/src/transformers/src/transformers/models/llama/*.py

# Do not commit the upstream FastV workspace.
/FastV/

# Python cache/build artifacts.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# Local environments.
.venv/
venv/
env/
.env
.env.*
!.env.example
!.env.template
.cache/

# Model/data/output artifacts.
models/
checkpoints/
outputs/
output/
figures/
*_eval/
*_eval_*/
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.onnx
!/D-QECG/src/transformers/src/transformers/models/
/D-QECG/src/transformers/src/transformers/models/*
!/D-QECG/src/transformers/src/transformers/models/llama/
/D-QECG/src/transformers/src/transformers/models/llama/*
!/D-QECG/src/transformers/src/transformers/models/llama/*.py

# Logs and experiment trackers.
*.log
logs/
runs/
wandb/

# OS/editor noise.
.DS_Store
Thumbs.db
.idea/
.vscode/
