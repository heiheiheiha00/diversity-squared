# Track only the D-squared workspace from this root.
/*
!/.gitignore
!/D_squared_method/
!/visualize/
!/D_squared_method/src/transformers/src/transformers/models/
/D_squared_method/src/transformers/src/transformers/models/*
!/D_squared_method/src/transformers/src/transformers/models/llama/
/D_squared_method/src/transformers/src/transformers/models/llama/*
!/D_squared_method/src/transformers/src/transformers/models/llama/*.py

# Do not commit the upstream FastV workspace.
/FastV/

# Python cache/build artifacts.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# Local environments.
.venv/
venv/
env/

# Model/data/output artifacts.
models/
checkpoints/
outputs/
output/
figures/
*_eval/
*_eval_*/
*.safetensors
*.bin
*.pt
*.pth
!/D_squared_method/src/transformers/src/transformers/models/
/D_squared_method/src/transformers/src/transformers/models/*
!/D_squared_method/src/transformers/src/transformers/models/llama/
/D_squared_method/src/transformers/src/transformers/models/llama/*
!/D_squared_method/src/transformers/src/transformers/models/llama/*.py

# OS/editor noise.
.DS_Store
Thumbs.db
.idea/
.vscode/

